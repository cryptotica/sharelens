{
  "name": "sharelens",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "test": "tsx --test tests/*.test.ts",
    "check:live": "tsx scripts/check-live.ts",
    "check:execution": "tsx scripts/check-execution.ts",
    "check:preview": "tsx scripts/check-preview.ts",
    "check:discovery": "tsx scripts/check-discovery.ts",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@vinext/cloudflare": "^1.0.0-beta.7",
    "next": "^16.1.6",
    "ox": "^1.7.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-server-dom-webpack": "^19.3.0",
    "viem": "^2.45.0",
    "vinext": "^1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.6",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "wrangler": "^4.130.0"
  },
  "type": "module"
}
